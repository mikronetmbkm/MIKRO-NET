# Salin berkas ini menjadi ".env" lalu isi sesuai lingkunganmu. JANGAN di-commit ke Git.
# APP_ENV: local = tampilkan detail galat (untuk laptop). production = sembunyikan detail (untuk hosting).
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mikronet
DB_USER=root
DB_PASS=
# Zona waktu untuk jam simpan/kumpul/nilai. WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura.
APP_TZ=Asia/Jakarta

# Langkah modul: 0 = siswa boleh melompat langkah (bawaan), 1 = wajib berurutan (langkah terkunci sampai yang sebelumnya selesai)
LANGKAH_URUT=0
